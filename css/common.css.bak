/* ==================== HAILANZU common.css ==================== */
/* 只包含营销模块样式，其他样式由各页面内联style提供 */

/* ==================== MARKETING - NAV SOCIAL ICONS ==================== */
.nav-social{display:flex;align-items:center;gap:10px}
.nav-social-btn{display:flex;align-items:center;justify-content:center;width:28px;height:28px;color:var(--rice);opacity:.4;transition:all .3s var(--ease-out);cursor:pointer;border:none;background:none;padding:0;text-decoration:none}
.nav-social-btn:hover{opacity:1;color:var(--gold);transform:scale(1.1)}
.nav-social-btn svg{pointer-events:none}

/* ==================== MARKETING - COMMUNITY SECTION ==================== */
.community-section{position:relative;background:#0A1A16;padding:clamp(48px,6vw,80px) clamp(24px,4vw,48px);border-top:1px solid rgba(184,134,11,.15)}
.community-inner{max-width:520px;margin:0 auto;text-align:center}
.community-accent-line{width:40px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:0 auto clamp(20px,3vw,32px);opacity:.4}
.community-title{font-family:var(--font-serif);font-weight:700;font-size:clamp(20px,2.8vw,30px);color:var(--rice);letter-spacing:4px;margin-bottom:8px}
.community-subtitle{font-family:var(--font-sans);font-weight:300;font-size:clamp(12px,1.4vw,14px);color:rgba(245,240,232,.35);margin-bottom:clamp(28px,4vw,40px);letter-spacing:1px}
.community-actions{display:flex;justify-content:center;gap:clamp(16px,2vw,24px);flex-wrap:wrap;margin-bottom:clamp(24px,3vw,36px)}
.community-action-btn{display:flex;align-items:center;gap:10px;padding:12px 28px;border:1px solid rgba(245,240,232,.1);border-radius:28px;color:var(--rice);text-decoration:none;transition:all .4s var(--ease-out);cursor:pointer;background:rgba(245,240,232,.03)}
.community-action-btn:hover{border-color:rgba(184,134,11,.35);background:rgba(184,134,11,.06);transform:translateY(-2px);box-shadow:0 6px 24px rgba(0,0,0,.2)}
.community-action-btn svg{opacity:.5;flex-shrink:0}
.community-action-btn:hover svg{opacity:1;color:var(--gold)}
.community-action-btn span:nth-child(2){font-family:var(--font-serif);font-size:13px;letter-spacing:3px;opacity:.7}
.community-action-btn:hover span:nth-child(2){opacity:1}
.community-action-desc{font-size:11px;opacity:.3;letter-spacing:1px;margin-left:4px;padding-left:10px;border-left:1px solid rgba(245,240,232,.08)}
.community-perk{font-family:var(--font-sans);font-size:12px;color:var(--gold);opacity:.5;letter-spacing:1px;display:flex;align-items:center;justify-content:center;gap:6px}

/* ==================== MARKETING - QR POPUP ==================== */
.qr-overlay{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s var(--ease-out)}
.qr-overlay.open{opacity:1;pointer-events:auto}
.qr-popup{position:relative;background:var(--ink-deep);border:1px solid rgba(184,134,11,.25);border-radius:12px;padding:32px 36px;text-align:center;transform:scale(.9);transition:transform .3s var(--ease-bounce)}
.qr-overlay.open .qr-popup{transform:scale(1)}
.qr-popup-close{position:absolute;top:12px;right:14px;background:none;border:none;color:var(--rice);opacity:.4;font-size:18px;cursor:pointer;transition:opacity .3s;padding:4px}
.qr-popup-close:hover{opacity:1}
.qr-popup-title{font-family:var(--font-serif);font-size:16px;color:var(--rice);letter-spacing:3px;margin-bottom:20px}
.qr-popup-img{width:180px;height:180px;background:var(--rice);border-radius:6px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.qr-popup-img .qr-placeholder{display:flex;flex-direction:column;align-items:center;gap:8px;color:var(--ink)}
.qr-placeholder-text{font-size:11px;color:var(--ink);opacity:.6;letter-spacing:1px}
.qr-popup-hint{font-size:12px;color:rgba(245,240,232,.4);letter-spacing:1px}

/* ==================== MARKETING - FLOATING CTA ==================== */
.floating-cta{position:fixed;right:24px;bottom:100px;z-index:900;display:flex;align-items:center;gap:8px;padding:10px 18px;background:linear-gradient(135deg,var(--seal),var(--seal-dark));border-radius:28px;color:var(--rice);font-family:var(--font-sans);font-size:13px;font-weight:500;cursor:pointer;box-shadow:0 4px 20px rgba(200,16,46,.35);transition:all .3s var(--ease-out);animation:ctaFloat 3s ease-in-out infinite;opacity:0;pointer-events:none}
.floating-cta.visible{opacity:1;pointer-events:auto}
.floating-cta:hover{transform:scale(1.05);box-shadow:0 6px 28px rgba(200,16,46,.45)}
.floating-cta-icon{font-size:16px}
.floating-cta-text{letter-spacing:1px}
@keyframes ctaFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}

/* ==================== MARKETING - PROMO BAR ==================== */
.promo-bar{position:fixed;bottom:0;left:0;right:0;z-index:899;display:flex;align-items:center;justify-content:center;gap:12px;padding:10px 20px;background:linear-gradient(90deg,var(--gold-dim),rgba(184,134,11,.1),var(--gold-dim));border-top:1px solid rgba(184,134,11,.2);font-family:var(--font-sans);font-size:13px;color:var(--gold-light);transform:translateY(100%);transition:transform .5s var(--ease-out)}
.promo-bar.visible{transform:translateY(0)}
.promo-bar-text{letter-spacing:1px}
.promo-bar-btn{background:var(--gold);color:var(--ink-deep);border:none;padding:4px 14px;border-radius:3px;font-size:11px;font-weight:600;letter-spacing:1px;cursor:pointer;transition:all .3s}
.promo-bar-btn:hover{background:var(--gold-light)}
.promo-bar-close{position:absolute;right:16px;background:none;border:none;color:var(--gold);opacity:.4;font-size:16px;cursor:pointer;transition:opacity .3s;padding:4px}
.promo-bar-close:hover{opacity:1}

/* ==================== MARKETING - FOOTER UPGRADE ==================== */
.footer-social-row{display:flex;align-items:center;justify-content:center;gap:20px;margin-bottom:20px}
.footer-social-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--rice);opacity:.35;transition:all .3s var(--ease-out);cursor:pointer}
.footer-social-icon:hover{opacity:1;color:var(--gold);transform:scale(1.1)}






/* ==================== MARKETING - RESPONSIVE ==================== */
@media(max-width:768px){
  .nav-social{display:none}
  .community-actions{flex-direction:column;align-items:center}
  .community-action-btn{width:100%;justify-content:center}
  .floating-cta{right:16px;bottom:80px;padding:8px 14px;font-size:12px}
  .floating-cta-text{display:none}
  .floating-cta-icon{font-size:20px}
  .promo-bar{font-size:11px;gap:8px;padding:8px 40px 8px 16px}
  .promo-bar-btn{padding:3px 10px;font-size:10px}
  .footer-social-row{gap:16px}

}
